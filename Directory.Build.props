<Project>

  <!--
    Properties shared by every project in the repository. Each project keeps the ones that are
    specific to it (AOT, Aspire, tests, XML documentation).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Makes `dotnet build` and `dotnet publish` honour the .editorconfig style severities
      (IDE0060 = error, among others).
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!--
      IDE0005 (unnecessary using) needs a documentation file to be analysed during build. Libraries do
      not generate one, so the rule still applies through `dotnet format` and the IDE. The API does
      generate it because Microsoft.AspNetCore.OpenApi reads XML comments for the document.
    -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

</Project>
