<Project>

  <!--
    Respeta en `dotnet build`/`dotnet publish` las severidades de las reglas de
    estilo de .editorconfig (IDE0060 = error, entre otras).
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      IDE0005 (using innecesario) necesita un fichero de documentación para
      analizarse en build. Las librerías no lo generan: la regla sigue
      aplicándose con `dotnet format` y en el IDE. La API sí lo genera porque
      Microsoft.AspNetCore.OpenApi lee los comentarios XML para el documento.
    -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

</Project>
