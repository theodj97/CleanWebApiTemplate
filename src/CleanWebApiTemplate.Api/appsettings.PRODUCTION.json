{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "Microsoft.Hosting.Lifetime": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ],
    "AllowCredentials": true
  },
  "OpenApi": {
    "Enabled": false
  },
  "ValidIssuers": [
    "https://login.example.com"
  ],
  "Audience": "https://api.example.com"
}
