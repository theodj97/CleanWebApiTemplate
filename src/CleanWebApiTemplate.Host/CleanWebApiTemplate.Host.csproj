<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a4490548-cd9d-4321-82ca-b9353e1834c4</UserSecretsId>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!--#if (ApiHealthCheck) -->
    <DefineConstants>$(DefineConstants);ApiHealthCheck</DefineConstants>
    <!--#endif -->
    <!--#if (IsSQLite) -->
    <DefineConstants>$(DefineConstants);IsSQLite</DefineConstants>
    <!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <!--#if (ApiHealthCheck && IsSQLite) -->
    <PackageReference Include="AspNetCore.HealthChecks.Sqlite" />
    <!--#endif -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\CleanWebApiTemplate.Application\CleanWebApiTemplate.Application.csproj" />
    <ProjectReference
      Include="..\CleanWebApiTemplate.Infrastructure\CleanWebApiTemplate.Infrastructure.csproj" />
  </ItemGroup>

</Project>