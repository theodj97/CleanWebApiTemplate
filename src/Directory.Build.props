<Project>

  <!--
    Inherits the repository-wide properties.
    https://learn.microsoft.com/en-us/visualstudio/msbuild/customize-by-directory
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Quality analyzers apply to production code only. Tests and local tools keep the SDK defaults, so
    naming and performance rules for test code do not hide the real signals.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

</Project>
