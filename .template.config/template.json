{
  "$schema": "http://json.schemastore.org/template",
  "author": "Theo Delvas Játiva",
  "repository": {
    "url": "https://github.com/theodj97/CleanWebApiTemplate",
    "type": "GitHub"
  },
  "classifications": [
    "WebApi",
    "ASP.NET Core",
    "CleanArchitecture",
    "Result Pattern",
    "REPR Pattern",
    "Minimal API",
    "Testing"
  ],
  "identity": "CleanWebApiTemplate",
  "name": "Minimal WebApi Template CA",
  "description": "Dotnet10 minimal WebApi Template with clean architecture focused based on microservices implementations",
  "shortName": "CleanWebApiTemplate",
  "sourceName": "CleanWebApiTemplate",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": true,
  "symbols": {
    "ApiHealthCheck": {
      "type": "parameter",
      "description": "Add Api HealthCheck endpoint",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "DataBase": {
      "type": "parameter",
      "description": "Select the DB to consume in your project",
      "datatype": "choice",
      "choices": [
        {
          "choice": "SQLite"
        }
      ],
      "defaultValue": "SQLite"
    },
    "IsSQLite": {
      "type": "computed",
      "value": "DataBase == \"SQLite\""
    },
    "ApplicationHttpsUrl": {
      "type": "parameter",
      "datatype": "text",
      "description": "Specify the app SSL URL, by default https://localhost:5001",
      "replaces": "https://localhost:5001",
      "defaultValue": "https://localhost:5001"
    },
    "ApplicationHttpUrl": {
      "type": "parameter",
      "datatype": "text",
      "description": "Specify the app URL, by default http://localhost:5000",
      "replaces": "http://localhost:5000",
      "defaultValue": "http://localhost:5000"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".gitignore",
            ".vs/**",
            "README.md",
            "node_modules/**",
            "**/[Bb]in/**",
            "**/[Oo]bj/**"
          ]
        },
        {
          "condition": "!ApiHealthCheck",
          "exclude": [
            "tests/CleanWebApiTemplate.Testing/FunctionalTests/HealthCheck/**"
          ]
        },
        {
          "condition": "!IsSQLite",
          "exclude": [
            "src/CleanWebApiTemplate.Infrastructure/Data/SqliteConnectionFactory.cs",
            "src/CleanWebApiTemplate.Infrastructure/Data/ISqliteConnectionFactory.cs",
            "src/CleanWebApiTemplate.Infrastructure/Data/SqliteDatabaseInitializer.cs",
            "src/CleanWebApiTemplate.Infrastructure/Repositories/TodoRepository.cs",
            "src/CleanWebApiTemplate.Infrastructure/Constants/TodoTable.cs",
            "tests/CleanWebApiTemplate.Testing/UnitTests/Repositories/TodoRepositoryTests.cs",
            "tests/CleanWebApiTemplate.Testing/UnitTests/Infrastructure/TodoTableTests.cs"
          ]
        }
      ]
    }
  ]
}
