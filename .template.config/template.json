{
  "$schema": "http://json.schemastore.org/template",
  "author": "Theo Delvas Játiva",
  "repository": {
    "url": "https://github.com/theodj97/CleanWebApiTemplate",
    "type": "GitHub"
  },
  "classifications": [
    "Web",
    "Web API",
    "Clean Architecture",
    "Aspire"
  ],
  "identity": "CleanWebApiTemplate",
  "name": "Clean Web API Template",
  "description": "ASP.NET Core 10 Minimal API with Clean Architecture, Native AOT, JWT, PostgreSQL, OpenBao and Aspire.",
  "shortName": [
    "clean-webapi",
    "cleanwebapi"
  ],
  "sourceName": "CleanWebApiTemplate",
  "tags": {
    "language": "C#",
    "type": "project",
    "framework": "net10.0"
  },
  "preferNameDirectory": true,
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the solution on create.",
      "defaultValue": "false"
    },
    "ApiUserSecretsId": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "defaultFormat": "d"
      },
      "replaces": "a4490548-cd9d-4321-82ca-b9353e1834c4"
    },
    "AppHostUserSecretsId": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "defaultFormat": "d"
      },
      "replaces": "6f4b1d0e-2c3a-4e5f-9a7b-1c2d3e4f5a6b"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".husky/_/**",
            ".agents/**",
            ".task-skill/**",
            ".tools/**",
            ".vs/**",
            ".idea/**",
            "skills-lock.json",
            "coverage-report/**",
            "docs/audit/**",
            "node_modules/**",
            "scripts/template-smoke.sh",
            "README.md",
            "**/TestResults/**",
            "**/[Bb]in/**",
            "**/[Oo]bj/**"
          ],
          "rename": {
            "README.template.md": "README.md"
          }
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "CleanWebApiTemplate.slnx"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by the solution.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore CleanWebApiTemplate.slnx'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    },
    {
      "id": "toolRestore",
      "condition": "(!skipRestore)",
      "description": "Restore the local .NET tools (Husky.Net, dotnet-coverage, ReportGenerator).",
      "manualInstructions": [
        {
          "text": "Run 'dotnet tool restore'"
        }
      ],
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "tool restore",
        "redirectStandardOutput": false
      },
      "continueOnError": true
    },
    {
      "id": "makeScriptsExecutable",
      "condition": "(OS != \"Windows_NT\")",
      "description": "Make the hook and helper scripts executable.",
      "manualInstructions": [
        {
          "text": "Run 'chmod +x scripts/*.sh .husky/pre-commit .husky/commit-msg .husky/pre-push'"
        }
      ],
      "actionId": "cb9a6cf3-4f5c-4860-b9d2-03a574959774",
      "args": {
        "+x": [
          "scripts/*.sh",
          ".husky/pre-commit",
          ".husky/commit-msg",
          ".husky/pre-push"
        ]
      },
      "continueOnError": true
    }
  ]
}
