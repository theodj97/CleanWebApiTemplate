{
  "LocalAuth": {
    "AppHostProject": "../aspire/Contoso.Shop.AppHost/Contoso.Shop.AppHost.csproj",
    "Algorithm": "HS256",
    "Issuer": "urn:contoso-shop:local-dev",
    "DefaultLifetimeMinutes": 60,
    "Apis": {
      "orders-api": {
        "Audience": "urn:contoso-shop:orders-api:local-dev",
        "RoleClaim": "role"
      },
      "catalog-api": {
        "Audience": "urn:contoso-shop:catalog-api:local-dev",
        "RoleClaim": "roles",
        "ScopeClaim": "scp"
      }
    },
    "Profiles": {
      "orders-admin": {
        "Api": "orders-api",
        "Subject": "0b7c2f4e-0000-4000-8000-000000000001",
        "Name": "local.admin",
        "Roles": [ "Admin" ]
      },
      "orders-customer": {
        "Api": "orders-api",
        "Subject": "0b7c2f4e-0000-4000-8000-000000000002",
        "Name": "local.customer",
        "Roles": [ "Customer" ]
      },
      "orders-no-roles": {
        "Api": "orders-api",
        "Subject": "0b7c2f4e-0000-4000-8000-000000000003",
        "Name": "local.noroles"
      },
      "catalog-reader": {
        "Api": "catalog-api",
        "Subject": "0b7c2f4e-0000-4000-8000-000000000004",
        "Name": "local.catalog.reader",
        "Scopes": [ "catalog.read" ]
      },
      "catalog-editor": {
        "Api": "catalog-api",
        "Subject": "0b7c2f4e-0000-4000-8000-000000000005",
        "Name": "local.catalog.editor",
        "Roles": [ "Catalog.Editor" ],
        "Scopes": [ "catalog.read", "catalog.write" ]
      },
      "catalog-no-scopes": {
        "Api": "catalog-api",
        "Subject": "0b7c2f4e-0000-4000-8000-000000000006",
        "Name": "local.catalog.noscopes",
        "Roles": [ "Catalog.Editor" ]
      }
    }
  }
}
