###############################################################################
# Default behaviour: normalise line endings automatically and use LF in the
# working tree for every text file. This way `dotnet format --verify-no-changes`
# and the hooks give the same result on Windows, WSL and Linux, regardless of
# core.autocrlf.
###############################################################################
* text=auto eol=lf

# C# and scripts always with LF (the hooks run with sh/Git Bash).
*.cs text eol=lf
*.sh text eol=lf

###############################################################################
# Binaries: never normalise or convert.
###############################################################################
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.pfx binary
*.snk binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary

###############################################################################
# Windows scripts (if added): keep CRLF.
###############################################################################
*.bat text eol=crlf
*.cmd text eol=crlf
