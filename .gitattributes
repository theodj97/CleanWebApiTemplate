###############################################################################
# Comportamiento por defecto: normalizar finales de línea automáticamente y
# usar LF en el árbol de trabajo para todo el texto. Así `dotnet format
# --verify-no-changes` y los hooks dan el mismo resultado en Windows, WSL y
# Linux, independientemente de core.autocrlf.
###############################################################################
* text=auto eol=lf

# C# y scripts siempre con LF (los hooks se ejecutan con sh/Git Bash).
*.cs text eol=lf
*.sh text eol=lf

###############################################################################
# Binarios: nunca normalizar ni convertir.
###############################################################################
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.pfx binary
*.snk binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary

###############################################################################
# Scripts de Windows (si se añaden): conservan CRLF.
###############################################################################
*.bat text eol=crlf
*.cmd text eol=crlf
