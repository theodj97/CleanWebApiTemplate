<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Same bar as the API: no reflection in the local examples pipeline. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration keys owned by the AppHost; linked like Tests.Shared does. -->
    <Compile Include="../../aspire/CleanWebApiTemplate.AppHost/AppHostContract.cs" Link="AppHostContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CleanWebApiTemplate.OpenApiExamples.UnitTests" />
  </ItemGroup>

</Project>
