{
  "requests": {
    "GET /api/Todo/{}": {
      "params": {
        "id": "{{seedUserTodoId}}"
      },
      "vars": {
        "pre-request": {
          "devtokenProfile": "user"
        }
      },
      "assertions": {
        "res.status": "eq 200",
        "res.body.createdBy": "eq local.user@example.com",
        "res.body.title": "eq Set up the local environment"
      }
    },
    "POST /api/Todo/filter": {
      "body": "overrides/POST_api_Todo_filter.body.json",
      "vars": {
        "pre-request": {
          "devtokenProfile": "user"
        }
      },
      "assertions": {
        "res.status": "eq 200",
        "res.body.length": "gte 1"
      }
    },
    "POST /api/Todo/titles": {
      "body": "overrides/POST_api_Todo_titles.body.json",
      "vars": {
        "pre-request": {
          "devtokenProfile": "user"
        }
      },
      "assertions": {
        "res.status": "eq 200",
        "res.body.length": "gte 1"
      }
    },
    "POST /api/Todo/": {
      "body": "overrides/POST_api_Todo.body.json",
      "pre-request": "scripts/create-todo.pre-request.js",
      "vars": {
        "pre-request": {
          "devtokenProfile": "user"
        }
      },
      "assertions": {
        "res.status": "eq 201",
        "res.body.createdBy": "eq local.user@example.com"
      }
    },
    "PUT /api/Todo/{}": {
      "params": {
        "id": "{{seedAdminTodoId}}"
      },
      "body": "overrides/PUT_api_Todo_id.body.json",
      "vars": {
        "pre-request": {
          "devtokenProfile": "admin"
        }
      },
      "assertions": {
        "res.status": "eq 200",
        "res.body.updatedBy": "eq local.admin@example.com",
        "res.body.status": "eq 2"
      }
    },
    "DELETE /api/Todo/{}": {
      "params": {
        "id": "{{seedDeletableTodoId}}"
      },
      "vars": {
        "pre-request": {
          "devtokenProfile": "operator"
        }
      },
      "assertions": {
        "res.status": "eq 200"
      }
    }
  },
  "folders": {}
}
