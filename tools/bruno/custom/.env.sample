# Copia este fichero como ".env" en esta misma carpeta y rellénalo. El .env NO se versiona.
# Genera los tokens del entorno aspire-local con:
#   dotnet local/tools/devtoken.cs dotenv tools/bruno/custom/.env [--lifetime <minutos>]
# Úsalas en Bruno como {{process.env.CLAVE}} o en scripts con bru.getProcessEnv("CLAVE").
DEVTOKEN_USER=
DEVTOKEN_OPERATOR=
DEVTOKEN_ADMIN=
DEVTOKEN_EXTERNAL=
DEVTOKEN_NO_ROLE=
