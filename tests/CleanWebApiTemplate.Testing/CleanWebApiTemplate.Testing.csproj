<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 / Microsoft.Testing.Platform test projects are self-executing -->
    <OutputType>Exe</OutputType>
    <!-- Use the Microsoft.Testing.Platform runner (instead of the xUnit.net native runner)
         when the test executable is run directly or via 'dotnet run' -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--#if (ApiHealthCheck) -->
    <DefineConstants>$(DefineConstants);ApiHealthCheck</DefineConstants>
    <!--#endif -->
    <!--#if (IsSQLite) -->
    <DefineConstants>$(DefineConstants);IsSQLite</DefineConstants>
    <!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CleanWebApiTemplate.Host/CleanWebApiTemplate.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>