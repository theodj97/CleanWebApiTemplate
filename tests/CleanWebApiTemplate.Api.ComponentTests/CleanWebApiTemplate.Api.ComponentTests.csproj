<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Program.cs reads appsettings from AppContext.BaseDirectory: keep the app's files in the test output. -->
    <Content Include="..\..\src\CleanWebApiTemplate.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanWebApiTemplate.Tests.Shared\CleanWebApiTemplate.Tests.Shared.csproj" />
    <!-- Aliased: the AppHost and the API both expose a public Program class (CS0433 otherwise). -->
    <ProjectReference Include="..\..\local\aspire\CleanWebApiTemplate.AppHost\CleanWebApiTemplate.AppHost.csproj" Aliases="apphost" />
    <ProjectReference Include="..\..\src\CleanWebApiTemplate.Api\CleanWebApiTemplate.Api.csproj" />
  </ItemGroup>

</Project>
